# ============================================================
# Training Data Bot - Environment Configuration
# Copy this to .env and fill in your values
# ALL keys must use the TRAINING_DATA_BOT_ prefix
# ============================================================

# --- AI Provider (choose one or both) ---
TRAINING_DATA_BOT_DEFAULT_AI_PROVIDER=openai          # "openai" or "anthropic"

# OpenAI
TRAINING_DATA_BOT_OPENAI_API_KEY=your_openai_api_key_here
TRAINING_DATA_BOT_OPENAI_MODEL=gpt-4o-mini
TRAINING_DATA_BOT_OPENAI_TEMPERATURE=0.7
TRAINING_DATA_BOT_OPENAI_MAX_TOKENS=4096

# Anthropic (optional)
TRAINING_DATA_BOT_ANTHROPIC_API_KEY=your_anthropic_api_key_here
TRAINING_DATA_BOT_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
TRAINING_DATA_BOT_ANTHROPIC_TEMPERATURE=0.7
TRAINING_DATA_BOT_ANTHROPIC_MAX_TOKENS=4096

# --- Processing ---
TRAINING_DATA_BOT_CHUNK_SIZE=1000
TRAINING_DATA_BOT_CHUNK_OVERLAP=200
TRAINING_DATA_BOT_MAX_WORKERS=4
TRAINING_DATA_BOT_MAX_CONCURRENT_REQUESTS=10

# --- Quality ---
TRAINING_DATA_BOT_QUALITY_THRESHOLD=0.7

# --- Export ---
TRAINING_DATA_BOT_DEFAULT_EXPORT_FORMAT=jsonl
TRAINING_DATA_BOT_EXPORT_INCLUDE_METADATA=true

# --- Logging ---
TRAINING_DATA_BOT_LOG_LEVEL=INFO
TRAINING_DATA_BOT_DEBUG=false

# --- Database (optional) ---
TRAINING_DATA_BOT_DATABASE_URL=sqlite:///training_data.db

# --- Decodo Web Scraping (optional) ---
TRAINING_DATA_BOT_DECODO_API_KEY=your_decodo_key_here
